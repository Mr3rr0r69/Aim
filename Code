    AuraDamagePercent = 0.12,      -- 12% max HP per hit
    AuraMinDamage = 15,            -- damage minimum
    AuraMaxDamage = 250,           -- cap damage
    AuraBaseInterval = 0.15,       -- interval dasar (HP rendah)
    AuraFastInterval = 0.08,       -- interval cepet (HP tinggi)
    AuraHpThreshold = 500,         -- di atas ini, interval cepet
    AuraMaxDPS = 250,              -- max damage per detik (server toleransi)
