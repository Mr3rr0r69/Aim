local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "DTC_ESP"
ESPFolder.Parent = Workspace
local function createESP(part, color, text)
    if not part then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = ESPFolder
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text or "?"
    label.TextColor3 = color or Color3.fromRGB(255, 0, 0)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.Parent = billboard
    local highlight = Instance.new("Highlight")
    highlight.Adornee = part.Parent
    highlight.FillColor = color or Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.7
    highlight.OutlineColor = color or Color3.fromRGB(255, 0, 0)
    highlight.OutlineTransparency = 0
    highlight.Parent = ESPFolder
end
local function clearESP()
    for _, child in ipairs(ESPFolder:GetChildren()) do child:Destroy() end
end
local function espLoop()
    if not State.ESP then return end
    clearESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then createESP(hrp, Color3.fromRGB(255, 50, 50), player.Name) end
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Health > 0 then
            local parent = obj.Parent
            if parent and parent ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(parent) then
                local hrp = parent:FindFirstChild("HumanoidRootPart") or parent:FindFirstChild("Torso")
                if hrp then createESP(hrp, Color3.fromRGB(255, 165, 0), parent.Name) end
            end
        end
    end
end

local function speedLoop()
    local hum = getHum()
    if not hum then return end
    hum.WalkSpeed = State.Speed and State.SpeedValue or 16
end

local flyBV, flyBG
local function flyLoop()
    local hrp = getHRP()
    if not hrp then return end
    if State.Fly then
        if not flyBV then
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            flyBV.Velocity = Vector3.zero
            flyBV.Parent = hrp
        end
        if not flyBG then
            flyBG = Instance.new("BodyGyro")
            flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
            flyBG.P = 1000; flyBG.D = 50
            flyBG.Parent = hrp
        end
        local moveDir = Vector3.zero
        local camCF = Camera.CFrame
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0,1,0) end
        flyBV.Velocity = moveDir.Magnitude > 0 and moveDir.Unit * State.FlySpeed or Vector3.zero
        flyBG.CFrame = camCF
    else
        if flyBV then flyBV:Destroy(); flyBV = nil end
        if flyBG then flyBG:Destroy(); flyBG = nil end
    end
end

