    State.CoinRemote = nil
    local candidates = {
        "AddCoin","Coin","Money","Cash","AddMoney","GiveCoin",
        "Reward","Claim","Buy","Purchase","Shop","Upgrade",
        "AddCash","GiveMoney","AddCurrency","Currency",
    }
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local lower = obj.Name:lower()
            for _, kw in ipairs(candidates) do
                if lower:find(kw:lower()) then
                    State.CoinRemote = obj
                    print("[Coin] Remote:", obj:GetFullName())
                    return obj
                end
            end
        end
    end
    return nil
