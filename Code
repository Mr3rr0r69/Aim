local function addCoin(amount)
    local remote = State.CoinRemote or findCoinRemote()
    if not remote then
        warn("[Coin] Remote ga ketemu!")
        return false
    end
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(amount)
            remote:FireServer("AddCoin", amount)
            remote:FireServer(amount, "coin")
        elseif remote:IsA("RemoteFunction") then
            remote:InvokeServer(amount)
        end
    end)
    return true
end

