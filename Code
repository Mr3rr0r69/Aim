-- ============ CHARACTER HELPERS ============
local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHRP()
    local char = getChar()
    return char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local char = getChar()
    return char:FindFirstChildOfClass("Humanoid")
end

-- ============ 1. ITEM COLLECTOR ============
local ITEM_KEYWORDS = {
    "ore", "gem", "crystal", "coin", "cash", "money", "gold", "diamond",
    "item", "pickup", "drop", "loot", "supply", "chest", "crate",
    "ammo", "medkit", "health", "food", "water", "fuel", "energy",
    "key", "dynamite", "explosive", "bomb", "scrap", "material",
}

local ITEM_FOLDERS = {
    "Ores", "Items", "Pickups", "Drops", "WorldItems",
    "Collectibles", "Loot", "Resources", "Currency",
}

local function isItemName(name)
    if not name then return false end
    local lower = name:lower()
    for _, kw in ipairs(ITEM_KEYWORDS) do
        if lower:find(kw) then return true end
    end
    return false
end

local function hasPickup(obj)
    return obj:FindFirstChild("PickUp") ~= nil
        or obj:FindFirstChild("Collect") ~= nil
        or obj:FindFirstChild("TouchInterest") ~= nil
        or obj:FindFirstChildWhichIsA("ProximityPrompt") ~= nil
        or obj:FindFirstChildWhichIsA("ClickDetector") ~= nil
end

local function collectItem(part)
    local prompt = part:FindFirstChildWhichIsA("ProximityPrompt")
        or (part.Parent and part.Parent:FindFirstChildWhichIsA("ProximityPrompt"))
    if prompt then
        pcall(function() fireproximityprompt(prompt) end)
        return true
    end
    local click = part:FindFirstChildWhichIsA("ClickDetector")
        or (part.Parent and part.Parent:FindFirstChildWhichIsA("ClickDetector"))
    if click then
        pcall(function() fireclickdetector(click) end)
        return true
    end
    local hrp = getHRP()
    if hrp then
        local old = hrp.CFrame
        hrp.CFrame = CFrame.new(part.Position)
        task.wait(0.05)
        hrp.CFrame = old
        return true
    end
    return false
end

local function scanAndCollect()
    if not State.ItemCollector then return end
    local hrp = getHRP()
    if not hrp then return end
    local rootPos = hrp.Position

    for _, folderName in ipairs(ITEM_FOLDERS) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("BasePart") then
                    if (obj.Position - rootPos).Magnitude <= State.CollectRadius then
                        if isItemName(obj.Name) or (obj.Parent and isItemName(obj.Parent.Name)) or hasPickup(obj) then
                            pcall(collectItem, obj)
                        end
                    end
                end
            end
        end
    end
end

-- ============ 2. ADAPTIVE STEALTH AURA KILL ============
-- Remote combat (auto-find)
local CombatRemote = nil

local function findCombatRemote()
    if CombatRemote and CombatRemote.Parent then return CombatRemote end
    CombatRemote = nil

    local candidates = {
        "Attack", "Hit", "Damage", "Combat", "Swing", "Strike",
        "Melee", "Weapon", "Sword", "Drill", "Mine", "DamageEnemy",
        "DealDamage", "HitEnemy", "AttackEnemy",
    }

    -- Scan ReplicatedStorage
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local lower = obj.Name:lower()
            for _, kw in ipairs(candidates) do
                if lower:find(kw:lower()) then
                    CombatRemote = obj
                    print("[Stealth Aura] Remote ditemukan:", obj:GetFullName())
                    return obj
                end
            end
        end
    end

    -- Scan Workspace (kadang remote di Workspace)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local lower = obj.Name:lower()
            for _, kw in ipairs(candidates) do
                if lower:find(kw:lower()) then
                    CombatRemote = obj
                    print("[Stealth Aura] Remote ditemukan:", obj:GetFullName())
                    return obj
                end
            end
        end
    end

    return nil
end

-- DPS tracker
local dpsTracker = { damageThisSecond = 0, lastReset = tick() }

local function canDealDamage(dmg)
    local now = tick()
    if now - dpsTracker.lastReset >= 1 then
        dpsTracker.damageThisSecond = 0
        dpsTracker.lastReset = now
    end
    if dpsTracker.damageThisSecond + dmg > State.AuraMaxDPS then
        return false
    end
    dpsTracker.damageThisSecond = dpsTracker.damageThisSecond + dmg
    return true
end

local function isEnemy(hum)
    local parent = hum.Parent
    if not parent then return false end
    if parent == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(parent) then return false end
    if hum.Health <= 0 then return false end
    return true
end

local function calculateDamage(targetHum)
    local maxHP = targetHum.MaxHealth
    if maxHP <= 0 or maxHP == math.huge then
        maxHP = targetHum.Health
    end
    local percentDmg = maxHP * State.AuraDamagePercent
    return math.floor(math.clamp(percentDmg, State.AuraMinDamage, State.AuraMaxDamage))
end

local function calculateInterval(targetHum)
    if targetHum.MaxHealth >= State.AuraHpThreshold then
        return State.AuraFastInterval
    end
    return State.AuraBaseInterval
end

local function hitViaRemote(targetHum)
    if not CombatRemote or not CombatRemote.Parent then return false end
    local targetChar = targetHum.Parent
    if CombatRemote:IsA("RemoteEvent") then
        pcall(function() CombatRemote:FireServer(targetChar) end)
        return true
    end
    if CombatRemote:IsA("RemoteFunction") then
        pcall(function() CombatRemote:InvokeServer(targetChar) end)
        return true
    end
    return false
end

local function hitViaTool(targetHum)
    local char = getChar()
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return false end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return false end
    local targetHRP = targetHum.Parent:FindFirstChild("HumanoidRootPart")
        or targetHum.Parent:FindFirstChild("Torso")
    if not targetHRP then return false end
    pcall(function()
        handle.CFrame = targetHRP.CFrame
        task.wait(0.05)
    end)
    return true
end

local function hitViaTakeDamage(targetHum, dmg)
    pcall(function() targetHum:TakeDamage(dmg) end)
    return true
end

local function performHit(targetHum)
    local targetChar = targetHum.Parent
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        or targetChar:FindFirstChild("Torso")
        or targetChar:FindFirstChild("UpperTorso")
    if not targetHRP then return false end

    local dmg = calculateDamage(targetHum)
    if not canDealDamage(dmg) then return false end

    if State.AuraRotateToTarget then
        local hrp = getHRP()
        if hrp then
            local lookAt = CFrame.lookAt(
                hrp.Position,
                Vector3.new(targetHRP.Position.X, hrp.Position.Y, targetHRP.Position.Z)
            )
            hrp.CFrame = lookAt
        end
    end

    if CombatRemote then
        if hitViaRemote(targetHum) then return true end
    end
    if hitViaTool(targetHum) then return true end
    return hitViaTakeDamage(targetHum, dmg)
end

local function collectTargets()
    local hrp = getHRP()
    if not hrp then return {} end
    local rootPos = hrp.Position
    local targets = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and isEnemy(obj) then
            local parent = obj.Parent
            local enemyHRP = parent:FindFirstChild("HumanoidRootPart")
                or parent:FindFirstChild("Torso")
                or parent:FindFirstChild("UpperTorso")
            if enemyHRP then
                local dist = (enemyHRP.Position - rootPos).Magnitude
                if dist <= State.AuraRadius then
                    table.insert(targets, {
                        hum = obj, dist = dist,
                        hp = obj.Health, maxHP = obj.MaxHealth,
                    })
                end
            end
        end
    end

    if State.AuraPrioritizeLowHP then
        table.sort(targets, function(a, b)
            if a.hp == b.hp then return a.dist < b.dist end
            return a.hp < b.hp
        end)
    else
        table.sort(targets, function(a, b) return a.dist < b.dist end)
    end
    return targets
end

local lastAuraHit = 0
local function auraKillLoop()
    if not State.AuraKill then return end
    -- Auto-find remote kalau belum ada
    if not CombatRemote then
        pcall(findCombatRemote)
    end

    local targets = collectTargets()
    if #targets == 0 then return end

    local target = targets[1]
    local interval = calculateInterval(target.hum)
    local now = tick()
    if now - lastAuraHit < interval then return end
    lastAuraHit = now

    pcall(performHit, target.hum)
end

-- ============ 3. NOCLIP ============
local function noclipLoop()
    if not State.Noclip then return end
    local char = getChar()
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end

-- ============ 4. ESP (No Tracer) ============
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "DTC_ESP"
ESPFolder.Parent = Workspace

local function createESP(part, color, text)
    if not part then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP"
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = ESPFolder

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text or (part.Parent and part.Parent.Name) or "?"
    label.TextColor3 = color or Color3.fromRGB(255, 0, 0)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.Parent = billboard

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_HL"
    highlight.Adornee = part.Parent
    highlight.FillColor = color or Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.7
    highlight.OutlineColor = color or Color3.fromRGB(255, 0, 0)
    highlight.OutlineTransparency = 0
    highlight.Parent = ESPFolder

    return billboard, highlight
end

local function clearESP()
    for _, child in ipairs(ESPFolder:GetChildren()) do
        child:Destroy()
    end
end

local function espLoop()
    if not State.ESP then return end
    clearESP()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                createESP(hrp, Color3.fromRGB(255, 50, 50), player.Name)
            end
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Health > 0 then
            local parent = obj.Parent
            if parent and parent ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(parent) then
                local hrp = parent:FindFirstChild("HumanoidRootPart") or parent:FindFirstChild("Torso")
                if hrp then
                    createESP(hrp, Color3.fromRGB(255, 165, 0), parent.Name)
                end
            end
        end
    end

    for _, folderName in ipairs({"Ores", "Items", "Pickups", "Resources"}) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, obj in ipairs(folder:GetChildren()) do
                if obj:IsA("BasePart") then
                    createESP(obj, Color3.fromRGB(0, 255, 100), obj.Name)
                end
            end
        end
    end
end

-- ============ 5. SPEED ============
local function speedLoop()
    local hum = getHum()
    if not hum then return end
    if State.Speed then
        hum.WalkSpeed = State.SpeedValue
    else
        hum.WalkSpeed = 16
    end
end

-- ============ 6. FLY ============
local flyBV, flyBG
local function flyLoop()
    local hrp = getHRP()
    if not hrp then return end

    if State.Fly then
        if not flyBV then
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            flyBV.Velocity = Vector3.zero
            flyBV.Parent = hrp
        end
        if not flyBG then
            flyBG = Instance.new("BodyGyro")
            flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
            flyBG.P = 1000
            flyBG.D = 50
            flyBG.Parent = hrp
        end

        local moveDir = Vector3.zero
        local camCF = Camera.CFrame
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0,1,0) end

        if moveDir.Magnitude > 0 then
            flyBV.Velocity = moveDir.Unit * State.FlySpeed
        else
            flyBV.Velocity = Vector3.zero
        end
        flyBG.CFrame = camCF
    else
        if flyBV then flyBV:Destroy(); flyBV = nil end
        if flyBG then flyBG:Destroy(); flyBG = nil end
    end
end

-- ============ 7. AUTO DRILL ============
local function autoDrillLoop()
    if not State.AutoDrill then return end
    local hrp = getHRP()
    if not hrp then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") then
                if (parent.Position - hrp.Position).Magnitude <= 30 then
                    pcall(function() fireproximityprompt(obj) end)
                end
            end
        end
    end
end

-- ============ 8. GOD MODE ============
local function godModeLoop()
    if not State.GodMode then return end
    local hum = getHum()
    if hum then
        hum.MaxHealth = math.huge
        hum.Health = math.huge
    end
end

