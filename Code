-- ============ BUTTON LOGIC ============

local function updateAimButtons()
    HeadBtn.BackgroundColor3   = AIM_PART == "Head"   and Color3.fromRGB(180,50,50)  or Color3.fromRGB(50,50,50)
    BodyBtn.BackgroundColor3   = AIM_PART == "Body"   and Color3.fromRGB(160,140,20) or Color3.fromRGB(50,50,50)
    BottomBtn.BackgroundColor3 = AIM_PART == "Bottom" and Color3.fromRGB(30,80,180)  or Color3.fromRGB(50,50,50)
end
updateAimButtons()

IconBtn.MouseButton1Click:Connect(function()
    Panel.Visible = not Panel.Visible
end)

CloseBtn.MouseButton1Click:Connect(function()
    Panel.Visible = false
end)

ToggleBtn.MouseButton1Click:Connect(function()
    AIMBOT_ON = not AIMBOT_ON
    if AIMBOT_ON then
        ToggleBtn.Text = "AIMBOT: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        StatusLabel.Text = "Status: Active ✅"
        StatusLabel.TextColor3 = Color3.fromRGB(100, 220, 100)
        FOVStroke.Color = Color3.fromRGB(0, 255, 100)
    else
        ToggleBtn.Text = "AIMBOT: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        StatusLabel.Text = "Status: Off ⏸"
        StatusLabel.TextColor3 = Color3.fromRGB(220, 100, 100)
        FOVStroke.Color = Color3.fromRGB(255, 215, 0)
    end
end)

HeadBtn.MouseButton1Click:Connect(function()
    AIM_PART = "Head" updateAimButtons()
end)
BodyBtn.MouseButton1Click:Connect(function()
    AIM_PART = "Body" updateAimButtons()
end)
BottomBtn.MouseButton1Click:Connect(function()
    AIM_PART = "Bottom" updateAimButtons()
end)

-- FOV Slider logic
local sliding = false
SliderBtn.MouseButton1Down:Connect(function() sliding = true end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliding = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not sliding then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local absPos = SliderBg.AbsolutePosition
        local absSize = SliderBg.AbsoluteSize
        local pct = math.clamp((input.Position.X - absPos.X) / absSize.X, 0, 1)
        AIM_FOV = math.floor(pct * 300)
        if AIM_FOV < 20 then AIM_FOV = 20 end
        SliderFill.Size = UDim2.new(pct, 0, 1, 0)
        SliderBtn.Position = UDim2.new(pct, 0, 0.5, 0)
        FOVLabel.Text = "FOV: " .. AIM_FOV
        -- Update circle size
        FOVCircle.Size = UDim2.new(0, AIM_FOV * 2, 0, AIM_FOV * 2)
        FOVCircle.Position = UDim2.new(0.5, -AIM_FOV, 0.5, -AIM_FOV)
    end
end)

-- Draggable icon
local dragging, dragStart, startPos = false, nil, nil

IconBtn.MouseButton1Down:Connect(function(x, y)
    dragging = true
    dragStart = Vector2.new(x, y)
    startPos = IconBtn.Position
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - Vector3.new(dragStart.X, dragStart.Y, 0)
        IconBtn.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
        Panel.Position = UDim2.new(
            IconBtn.Position.X.Scale, IconBtn.Position.X.Offset + 65,
            IconBtn.Position.Y.Scale, IconBtn.Position.Y.Offset - 30
        )
    end
end)

-- ============ AIMBOT LOOP ============

RunService.RenderStepped:Connect(function()
    if not AIMBOT_ON then return end
    local target = findClosestNPC()
    if not target then return end

    local currentCF = Camera.CFrame
    local direction = (target.Position - currentCF.Position).Unit
    local targetCF = CFrame.lookAt(currentCF.Position, currentCF.Position + direction)
    Camera.CFrame = currentCF:Lerp(targetCF, AIM_SMOOTHNESS)
end)

print("[Universal Aimbot] Loaded! Tap 🎯 to open.")
