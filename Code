-- ============ 1. ITEM PULL (TP ITEM KE PLAYER) ============
local ITEM_KEYWORDS = {
    "ore", "gem", "crystal", "coin", "cash", "money", "gold", "diamond",
    "item", "pickup", "drop", "loot", "supply", "chest", "crate",
    "ammo", "medkit", "health", "food", "water", "fuel", "energy",
    "key", "dynamite", "explosive", "bomb", "scrap", "material",
}
local ITEM_FOLDERS = {
    "Ores", "Items", "Pickups", "Drops", "WorldItems",
    "Collectibles", "Loot", "Resources", "Currency",
}

local function isItemName(name)
    if not name then return false end
    local lower = name:lower()
    for _, kw in ipairs(ITEM_KEYWORDS) do
        if lower:find(kw) then return true end
    end
    return false
end
local function hasPickup(obj)
    return obj:FindFirstChild("PickUp") ~= nil
        or obj:FindFirstChild("Collect") ~= nil
        or obj:FindFirstChild("TouchInterest") ~= nil
        or obj:FindFirstChildWhichIsA("ProximityPrompt") ~= nil
        or obj:FindFirstChildWhichIsA("ClickDetector") ~= nil
end
local function isBasePart(obj)
    return obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("Part")
end

local function pullItemToPlayer(part)
    local hrp = getHRP()
    if not hrp or not part or not part.Parent then return false end
    local targetPos = hrp.Position + Vector3.new(0, State.ItemTPHeight, 0)
    pcall(function()
        part.CFrame = CFrame.new(targetPos)
        part.Velocity = Vector3.zero
        part.AssemblyLinearVelocity = Vector3.zero
    end)
    task.wait(0.05)
    local prompt = part:FindFirstChildWhichIsA("ProximityPrompt")
        or (part.Parent and part.Parent:FindFirstChildWhichIsA("ProximityPrompt"))
    if prompt then
        pcall(function() fireproximityprompt(prompt) end)
        return true
    end
    local click = part:FindFirstChildWhichIsA("ClickDetector")
        or (part.Parent and part.Parent:FindFirstChildWhichIsA("ClickDetector"))
    if click then
        pcall(function() fireclickdetector(click) end)
        return true
    end
    return true
end

local function scanAndPull()
    if not State.ItemCollector then return end
    local hrp = getHRP()
    if not hrp then return end
    local rootPos = hrp.Position
    for _, folderName in ipairs(ITEM_FOLDERS) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                if isBasePart(obj) then
                    if (obj.Position - rootPos).Magnitude <= State.CollectRadius then
                        if isItemName(obj.Name) or (obj.Parent and isItemName(obj.Parent.Name)) or hasPickup(obj) then
                            pcall(pullItemToPlayer, obj)
                        end
                    end
                end
            end
        end
    end
end

-- ============ 2. ADAPTIVE AURA KILL ============
local CombatRemote = nil
local function findCombatRemote()
    if CombatRemote and CombatRemote.Parent then return CombatRemote end
    CombatRemote = nil
    local candidates = {
        "Attack","Hit","Damage","Combat","Swing","Strike",
        "Melee","Weapon","Sword","Drill","Mine","DamageEnemy",
        "DealDamage","HitEnemy","AttackEnemy",
    }
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local lower = obj.Name:lower()
            for _, kw in ipairs(candidates) do
                if lower:find(kw:lower()) then
                    CombatRemote = obj
                    print("[Stealth Aura] Remote:", obj:GetFullName())
                    return obj
                end
            end
        end
    end
    return nil
end

local dpsTracker = { damageThisSecond = 0, lastReset = tick() }
local function canDealDamage(dmg)
    local now = tick()
    if now - dpsTracker.lastReset >= 1 then
        dpsTracker.damageThisSecond = 0
        dpsTracker.lastReset = now
    end
    if dpsTracker.damageThisSecond + dmg > State.AuraMaxDPS then return false end
    dpsTracker.damageThisSecond = dpsTracker.damageThisSecond + dmg
    return true
end

local function isEnemy(hum)
    local parent = hum.Parent
    if not parent then return false end
    if parent == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(parent) then return false end
    if hum.Health <= 0 then return false end
    return true
end

local function calculateDamage(targetHum)
    local maxHP = targetHum.MaxHealth
    if maxHP <= 0 or maxHP == math.huge then maxHP = targetHum.Health end
    local percentDmg = maxHP * State.AuraDamagePercent
    return math.floor(math.clamp(percentDmg, State.AuraMinDamage, State.AuraMaxDamage))
end
local function calculateInterval(targetHum)
    if targetHum.MaxHealth >= State.AuraHpThreshold then return State.AuraFastInterval end
    return State.AuraBaseInterval
end

local function hitViaRemote(targetHum)
    if not CombatRemote or not CombatRemote.Parent then return false end
    local targetChar = targetHum.Parent
    if CombatRemote:IsA("RemoteEvent") then
        pcall(function() CombatRemote:FireServer(targetChar) end)
        return true
    end
    if CombatRemote:IsA("RemoteFunction") then
        pcall(function() CombatRemote:InvokeServer(targetChar) end)
        return true
    end
    return false
end
local function hitViaTakeDamage(targetHum, dmg)
    pcall(function() targetHum:TakeDamage(dmg) end)
    return true
end

local function performHit(targetHum)
    local targetChar = targetHum.Parent
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        or targetChar:FindFirstChild("Torso")
        or targetChar:FindFirstChild("UpperTorso")
    if not targetHRP then return false end
    local dmg = calculateDamage(targetHum)
    if not canDealDamage(dmg) then return false end
    if State.AuraRotateToTarget then
        local hrp = getHRP()
        if hrp then
            hrp.CFrame = CFrame.lookAt(hrp.Position,
                Vector3.new(targetHRP.Position.X, hrp.Position.Y, targetHRP.Position.Z))
        end
    end
    if CombatRemote then
        if hitViaRemote(targetHum) then return true end
    end
    return hitViaTakeDamage(targetHum, dmg)
end

local function collectTargets()
    local hrp = getHRP()
    if not hrp then return {} end
    local rootPos = hrp.Position
    local targets = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and isEnemy(obj) then
            local parent = obj.Parent
            local enemyHRP = parent:FindFirstChild("HumanoidRootPart")
                or parent:FindFirstChild("Torso")
                or parent:FindFirstChild("UpperTorso")
            if enemyHRP then
                local dist = (enemyHRP.Position - rootPos).Magnitude
                if dist <= State.AuraRadius then
                    table.insert(targets, {hum = obj, dist = dist, hp = obj.Health})
                end
            end
        end
    end
    if State.AuraPrioritizeLowHP then
        table.sort(targets, function(a, b)
            if a.hp == b.hp then return a.dist < b.dist end
            return a.hp < b.hp
        end)
    else
        table.sort(targets, function(a, b) return a.dist < b.dist end)
    end
    return targets
end

local lastAuraHit = 0
local function auraKillLoop()
    if not State.AuraKill then return end
    if not CombatRemote then pcall(findCombatRemote) end
    local targets = collectTargets()
    if #targets == 0 then return end
    local target = targets[1]
    local interval = calculateInterval(target.hum)
    local now = tick()
    if now - lastAuraHit < interval then return end
    lastAuraHit = now
    pcall(performHit, target.hum)
end

-- ============ 3. STEALTH NPC ============
local function freezeNPCLoop()
    if not State.FreezeNPC then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and isEnemy(obj) then
            pcall(function()
                obj.WalkSpeed = 0
                obj.JumpPower = 0
                obj.JumpHeight = 0
            end)
        end
    end
end

local function invisibleLoop()
    if not State.Invisible then return end
    local char = getChar()
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = 1
            part.Transparency = 1
        end
        if part:IsA("Decal") then
            part.Transparency = 1
        end
    end
end

