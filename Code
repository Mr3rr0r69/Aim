-- Universal NPC Aimbot Script
-- Works on any Roblox game with NPCs/Bots
-- Targets only non-player Humanoids

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- ============ SETTINGS ============
local AIM_PART = "Head"
local AIM_FOV = 150
local AIM_SMOOTHNESS = 0.2
local AIMBOT_ON = false
local MAX_DISTANCE = 500

-- ============ UNIVERSAL NPC DETECTION ============
-- Instead of keywords, we just check:
-- 1. Has a Humanoid
-- 2. Is alive
-- 3. Is NOT a real player character

local function isNPC(model)
    local hum = model:FindFirstChildWhichIsA("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    -- Not a real player
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then return false end
    end

    return true  -- Any alive non-player humanoid = NPC
end

local function getAimPart(model)
    if AIM_PART == "Head" then
        return model:FindFirstChild("Head")
            or model:FindFirstChild("HumanoidRootPart")

    elseif AIM_PART == "Body" then
        return model:FindFirstChild("HumanoidRootPart")
            or model:FindFirstChild("UpperTorso")
            or model:FindFirstChild("Torso")

    elseif AIM_PART == "Bottom" then
        return model:FindFirstChild("LowerTorso")
            or model:FindFirstChild("Left Leg")
            or model:FindFirstChild("RightLowerLeg")
            or model:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function getCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function findClosestNPC()
    local center = getCenter()
    local closest = nil
    local closestDist = math.huge
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and isNPC(obj) then
            local part = getAimPart(obj)
            if part then
                if root then
                    local worldDist = (part.Position - root.Position).Magnitude
                    if worldDist > MAX_DISTANCE then continue end
                end

                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < AIM_FOV and dist < closestDist then
                        closestDist = dist
                        closest = part
                    end
                end
            end
        end
    end

    return closest
end

