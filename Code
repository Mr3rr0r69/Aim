local function findSellButton()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    local keywords = {"sell", "jual", "shop", "market", "trade", "submit"}
    for _, gui in ipairs(playerGui:GetDescendants()) do
        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
            local nameLower = gui.Name:lower()
            local textLower = (gui.Text or ""):lower()
            for _, kw in ipairs(keywords) do
                if nameLower:find(kw) or textLower:find(kw) then
                    return gui
                end
            end
        end
    end
    return nil
end

local function autoSellLoop()
    if not AutoFarm.AutoSell then return end
    local now = tick()
    if now - AutoFarm.LastSell < AutoFarm.SellInterval then return end
    AutoFarm.LastSell = now

    local remote = SellRemote or findSellRemote()
    if remote then
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer()
                remote:FireServer("all")
                remote:FireServer("sell")
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer()
                remote:InvokeServer("all")
            end
        end)
    end

    local btn = findSellButton()
    if btn then
        pcall(function()
            if getconnections then
                for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
                    if conn.Fire then pcall(conn.Fire, conn) end
                end
            end
            pcall(function() btn.MouseButton1Click:Fire() end)
        end)
    end
end

local function autoPromptLoop()
    if not AutoFarm.AutoPrompt then return end
    local now = tick()
    if now - AutoFarm.LastPrompt < AutoFarm.PromptInterval then return end
    AutoFarm.LastPrompt = now
    local hrp = getHRP()
    if not hrp then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") then
                if (parent.Position - hrp.Position).Magnitude <= AutoFarm.PromptRadius then
                    pcall(function() fireproximityprompt(obj) end)
                end
            end
        end
    end
end

local function autoQuestLoop()
    if not AutoFarm.AutoQuest then return end
    local now = tick()
    if now - AutoFarm.LastQuest < AutoFarm.QuestInterval then return end
    AutoFarm.LastQuest = now

    local remote = QuestRemote or findQuestRemote()
    if remote then
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer()
                remote:FireServer("claim")
                remote:FireServer("all")
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer()
                remote:InvokeServer("claim")
            end
        end)
    end
end

